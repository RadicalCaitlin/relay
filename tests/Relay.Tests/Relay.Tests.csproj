<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Every process a test runs holds two pool threads reading its output, and tests run in
         parallel. With the default minimum of one thread per core, a four-core CI machine ran out,
         and work then waited seconds for a thread: long enough to fail tests that time a run. -->
    <ThreadPoolMinThreads>64</ThreadPoolMinThreads>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Spectre.Console.Testing" Version="0.57.2" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Relay.Core\Relay.Core.csproj" />
    <ProjectReference Include="..\..\src\Relay.Agents\Relay.Agents.csproj" />
    <!-- Also launched as a separate process by the tests that drive the built CLI through RelayHarness. -->
    <ProjectReference Include="..\..\src\Relay.Cli\Relay.Cli.csproj" />
  </ItemGroup>

</Project>
